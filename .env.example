# OpenPark Environment Configuration Example
# Copy to .env and adjust as necessary for local development or production

# Backend API Configuration
OPENPARK_API_KEY=dev-key
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_USER=openpark
POSTGRES_PASSWORD=openpark
POSTGRES_DB=openpark
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://openpark:openpark@localhost:5432/openpark

# Redis Configuration (Live Pub/Sub & Caching)
REDIS_URL=redis://localhost:6379/0

# Routing Engine (OSRM)
OSRM_URL=http://localhost:5000

# Vector Mapping: Powered by MapLibre GL JS (Zero tokens or API keys required)
# https://maplibre.org/maplibre-gl-js/docs/API/

# Supabase Cloud Integration (https://supabase.com)
# Option A (Recommended): Direct REST & Realtime credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-optional

# Option B: Direct PostgreSQL connection to Supabase pooler or direct instance
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Mappls (MapmyIndia) REST API (https://github.com/mappls-api/mapmyindia-rest-api)
MAPPLS_REST_KEY=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
